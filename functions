#!/usr/bin/env bash

log() {
    echo "$(date +"[%Y-%m-%d %T,%3N]") <docker-entrypoint> $*"
}

set_java_home() {
    # Resolve the real java binary (<java home>/bin/java) and go up two levels.
    # Works for any Java version, with or without the pre-Java-9 jre/ layout.
    local java_bin
    java_bin=$(readlink -f "$(command -v java)")
    JAVA_HOME=$(dirname "$(dirname "${java_bin}")")
    if [ ! -x "${JAVA_HOME}/bin/java" ]; then
        log "WARN: could not determine JAVA_HOME (java binary: ${java_bin:-not found})"
    fi
}

instPkg() {
    for pkg in $*; do
        if [ $(dpkg-query -W -f='${Status}' "${pkg}" 2>/dev/null | grep -c "ok installed") -eq 0 ];
        then
            apt-get -qy install "${pkg}";
        fi
    done
}

# Validate that any included hotfixes have been applied
validate() (
  shopt -s nullglob
  for i in /usr/local/unifi/hotfixes/*-validate.md5sum; do
    md5sum -c "$i" > /dev/null 2>&1 || return 1
    echo "Hotfix validated: $(basename ${i::-16})"
  done
)
